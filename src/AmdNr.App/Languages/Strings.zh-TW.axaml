<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.TraditionalChinese">

  <!-- The window font. Inter carries the Latin text; a CJK face after it carries the rest. -->
  <FontFamily x:Key="AppFont">Inter, Microsoft JhengHei UI, Microsoft JhengHei, sans-serif</FontFamily>

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">在 Radeon 上執行 DLSS 5 神經渲染，一鍵裝好</sys:String>

  <sys:String x:Key="Str.Games">遊戲</sys:String>
  <sys:String x:Key="Str.RemoveGame">從清單移除</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">只把這一列從清單中移除，遊戲資料夾裡的檔案不會被動到。</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} 已從清單移除，它的資料夾裡沒有任何變動。</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} 已從清單移除，但 add-on 仍裝在它的資料夾裡。如需解除安裝，請把該資料夾重新加回來。</sys:String>
  <sys:String x:Key="Str.NoGames">這裡還沒有內容。請新增遊戲或模擬器執行所在的資料夾。</sys:String>
  <sys:String x:Key="Str.PickFolder">選擇遊戲執行所在的資料夾</sys:String>
  <sys:String x:Key="Str.AddGameMany">搜尋資料夾</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">選擇存放遊戲的資料夾</sys:String>
  <sys:String x:Key="Str.AddGameNone">在「{0}」下找不到像遊戲的內容。</sys:String>

  <sys:String x:Key="Str.Preset">路線</sys:String>
  <sys:String x:Key="Str.Install">安裝</sys:String>
  <sys:String x:Key="Str.Uninstall">解除安裝</sys:String>
  <sys:String x:Key="Str.OpenFolder">開啟資料夾</sys:String>

  <sys:String x:Key="Str.System">本機</sys:String>
  <sys:String x:Key="Str.Gpu">顯示卡</sys:String>
  <sys:String x:Key="Str.Driver">驅動程式</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 執行階段</sys:String>
  <sys:String x:Key="Str.HipMissing">找不到 amdhip64_7.dll。新版 Adrenalin 驅動程式內含它；HIP 6 不行。</sys:String>
  <sys:String x:Key="Str.NotRadeon">這看起來不是 Radeon 顯示卡。此神經網路僅支援 RDNA3 與 RDNA4。</sys:String>
  <sys:String x:Key="Str.Ready">就緒</sys:String>

  <sys:String x:Key="Str.Payloads">檔案</sys:String>
  <sys:String x:Key="Str.Downloading">正在下載</sys:String>
  <sys:String x:Key="Str.Verifying">正在驗證既有檔案…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">已下載並驗證。</sys:String>
  <sys:String x:Key="Str.ManifestLocal">無法讀取已發布的下載清單，目前使用本程式內建的副本。</sys:String>
  <sys:String x:Key="Str.ManifestFailed">無法讀取下載清單。請檢查網路連線後再試一次。</sys:String>

  <sys:String x:Key="Str.Language">語言</sys:String>
  <sys:String x:Key="Str.UpdateWorking">正在下載更新…</sys:String>
  <sys:String x:Key="Str.Dismiss">稍後再說</sys:String>

  <sys:String x:Key="Str.LogSaved">完整記錄檔已寫入本程式所在目錄。</sys:String>
  <sys:String x:Key="Str.Working">處理中…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">無法讀取遊戲清單。原檔已另存為旁邊的 {0}，並建立了新的清單。</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">仍在寫入遊戲資料夾，需要幾秒鐘；完成後再關閉視窗。</sys:String>
  <sys:String x:Key="Str.FreeTitle">本軟體免費。如果你為它付了錢，你被騙了。</sys:String>
  <sys:String x:Key="Str.FreeBody">這裡的一切都不收費——安裝程式、add-on、執行階段、模型權重都不賣。如果有人向你收費，或賣你「序號」「專業版」，請要求退款：他們賣給你的東西在這個頁面上都是免費的。</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">它是開源的，並將一直開源：你可以閱讀、修改、自行建置、分享給朋友。我們唯一的請求是：不要把它變成付費版本。</sys:String>
  <sys:String x:Key="Str.SupportSection">支持</sys:String>
  <sys:String x:Key="Str.SupportNote">自由樂捐，不會換來任何額外功能</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">請喝一杯咖啡。</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">本專案在巴西的募款。</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — 作者 danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">神經網路本身，也是這一切存在的原因：正是它讓 DLSS 5 的神經渲染得以在 Radeon 上執行。本程式下載的執行階段與模型權重都是他的成果，不是我們的。謝謝你，danielblnc。</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">透過 ReShade 把該神經網路接入遊戲的部分：即本程式安裝的 add-on，以及可供你選擇的各個發行版本。MIT 授權，與本安裝程式是不同的儲存庫。</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — 大家都在這裡</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">新版本、哪些遊戲能用，以及出問題時去哪裡發問。</sys:String>
  <sys:String x:Key="Str.CreditsSection">致謝</sys:String>

  <sys:String x:Key="Str.Scan">掃描遊戲</sys:String>
  <sys:String x:Key="Str.Scanning">正在讀取 Steam、Epic、GOG、EA、Ubisoft、Battle.net 與 Xbox…</sys:String>
  <sys:String x:Key="Str.Search">搜尋遊戲…</sys:String>
  <sys:String x:Key="Str.Settings">設定</sys:String>
  <sys:String x:Key="Str.WillDownload">檔案會在安裝時下載並驗證。</sys:String>
  <sys:String x:Key="Str.NoRoute">這款遊戲使用的渲染方式都沒有可用路線：add-on 支援 D3D11、D3D12、Vulkan 與 OpenGL，32 位元遊戲支援 D3D8、D3D9 與 D3D11。32 位元 OpenGL 遊戲、64 位元 D3D9 遊戲與軟體渲染器都不支援。</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">這款遊戲可以在 {1} 上執行。請在遊戲本身的圖形設定裡改為 {0}——這是此處選定的路線；換成其他 API，add-on 看到的就是另一回事了。</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">這是虛幻引擎遊戲：在啟動選項裡加上 -{0}。</sys:String>
  <sys:String x:Key="Str.CheckWiki">在 PCGamingWiki 上查看這款遊戲</sys:String>
  <!-- Feedback and layout -->
  <sys:String x:Key="Str.EmptyTitle">還沒有遊戲</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">沒有相符結果</sys:String>
  <sys:String x:Key="Str.NoMatch">清單中沒有符合「{0}」的遊戲。</sys:String>
  <sys:String x:Key="Str.ScanningShort">掃描中…</sys:String>
  <sys:String x:Key="Str.ScanDone">掃描完成：找到 {0} 款遊戲，其中 {1} 款是新的。</sys:String>
  <sys:String x:Key="Str.InstalledBadge">已安裝</sys:String>
  <sys:String x:Key="Str.Close">關閉</sys:String>
  <sys:String x:Key="Str.CloseHint">關閉 (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">遊戲的執行檔</sys:String>
  <sys:String x:Key="Str.ExeChoose">選擇…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">使用偵測到的檔案</sys:String>
  <sys:String x:Key="Str.ExeNone">此資料夾中找不到執行檔。</sys:String>
  <sys:String x:Key="Str.ExeNote">位元數與 API 從這個檔案讀取，下方的路線也由它決定。有的遊戲在根目錄放一個小啟動器、真正的程式在 Bin64 裡，這種情況會判斷錯誤——如果這裡的位元數不是你預期的，請指向正確的檔案。</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">這個檔案是你選的，偵測不會再更動它——重新掃描後也不會。</sys:String>
  <sys:String x:Key="Str.ExeNotHere">該檔案不在這款遊戲的資料夾裡。</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">該檔案不是可讀取的 Windows 執行檔。</sys:String>
  <sys:String x:Key="Str.RouteMismatch">此路線適用於 {0} 遊戲，而上方的執行檔是 {1}。你仍可繼續——偵測可能讀錯了檔案——但如果沒讀錯，這樣裝了也不會載入。</sys:String>
  <sys:String x:Key="Str.VersionSection">Add-on 版本</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade 載入為</sys:String>
  <sys:String x:Key="Str.ProxyNote">「自動」會選 dxgi.dll，適用於所有 Direct3D。只有當遊戲不肯載入它時才換別的——有些遊戲只載入 d3d12.dll。</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler 載入為</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">「自動」會選 dxgi.dll。如果 dxgi.dll 必須留給別的東西（例如你想保留的 ReShade），請選 winmm.dll。</sys:String>
  <sys:String x:Key="Str.ProxyAuto">自動</sys:String>
  <sys:String x:Key="Str.PrefetchAll">立即全部下載</sys:String>
  <sys:String x:Key="Str.ClearCache">清除快取</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">刪除已下載的檔案、封面與版本清單。已裝進遊戲的內容不受影響；下次安裝時會重新下載所需檔案。</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">清除</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">其中的所有內容會在下次安裝時重新下載。</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">保持快取不變。</sys:String>
  <sys:String x:Key="Str.CacheCleared">快取已清空——釋放了 {0}。</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">所有檔案都已存在，並且剛剛全部驗證通過。</sys:String>
  <sys:String x:Key="Str.VersionShipped">內建</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">本安裝程式發布時附帶的版本。</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">取自 GitHub 上的 v{0} 發行版，並依該版本公布的雜湊值驗證。</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler 版本</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}，取自其 GitHub 發行版。其中每個檔案都依下載清單提供的雜湊值驗證。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">它還會安裝 lmxxf 執行階段的模型權重，約 590 MB，僅 RDNA4 顯示卡會用到。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">它也可以帶上 mochizuki 執行階段：見下方的 NR 執行階段。</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR 執行階段</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">同時安裝 mochizuki，作為第二個 NR 執行階段（實驗性）</sys:String>
  <sys:String x:Key="Str.MochizukiNote">由 mochizuki0323 移植到 Vulkan 的 DLSS 5 神經網路。僅限 RDNA4：RX 9000 系列，AMD 驅動程式 25.10 或更新。它會加入 MochizukiNrRuntime.dll 和一個包含模型的 dlssnr-amd 資料夾，約需下載 141 MB。NR 執行階段仍是 danielblnc 的：要使用 mochizuki，請在 OptiScaler 的 Neural 分頁的 NR runtime 中選擇它，然後重新啟動遊戲。每款遊戲首次啟動時會花幾秒鐘編譯神經網路。取消勾選後，下次安裝會移除本程式裝入的相關檔案。</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">同時安裝 mochizuki，作為第二個 NR 執行階段（實驗性）</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">由 mochizuki0323 移植到 Vulkan 的 DLSS 5 神經網路，add-on 從 v0.6.8 起可用它取代 danielblnc 的執行階段。僅限 RDNA4：RX 9000 系列，AMD 驅動程式 25.10 或更新。它會加入 MochizukiNrRuntime.dll 和一個包含模型的 dlssnr-amd 資料夾，約需下載 141 MB。要使用它，請在 add-on 面板的 NR runtime 中選擇 mochizuki (Vulkan)，然後重新啟動遊戲。每款遊戲首次啟動時最多需要一分鐘編譯神經網路。取消勾選後，下次安裝會移除本程式裝入的相關檔案。</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">此顯示卡 ({0}) 不提供：mochizuki 需要 RDNA4（RX 9000 系列）的 FP8 矩陣指令。</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">本程式無法辨識這是哪張顯示卡；除 RX 9000 系列外，mochizuki 在遊戲裡都不會啟用。</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">選擇安裝路線</sys:String>
  <sys:String x:Key="Str.PickRouteBody">本程式無法判斷 {0} 使用哪種圖形 API，因此不會替你選路線。設定裡提供 DLSS、FSR 或 XeSS 的 D3D12 遊戲選 OptiScaler；其他遊戲（D3D11 或 D3D12）選 ReShade。在你選擇之前無法安裝。</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">圖形 API 不明，請在下方自行選擇路線。</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc 的執行階段</sys:String>
  <sys:String x:Key="Str.SupporterChoose">這款遊戲可以裝兩個版本之一。請選擇：亮起的那個會被裝入。</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">公開發行版 ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">由本程式為你下載並驗證，無需自己提供任何檔案。</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">本機贊助者版 ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">選擇我的 version.dll 或安裝程式…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">選擇其他檔案…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">比公開發行版更新，來自你自己的 version.dll 或 dlssnr_on_amd_setup.exe。</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 新增了 RDNA3 顯示卡的核心。</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">贊助者版不對外散布：本程式從不下載它，其作者也不公開提供。你的檔案每次裝入時都會依 SHA-256 驗證，並保留一份驗證過的副本，其他遊戲就不必再次索取。</sys:String>
  <sys:String x:Key="Str.SupporterUse">使用我的贊助者檔案…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">公開發行版</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">你的 version.dll 或 dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">任何 DLL 或安裝程式</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">目前使用：本程式下載的執行階段。</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">正在使用你檔案中的 {0}。</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">正在使用 {0}：這是你先前選擇時本程式保留的驗證副本。</sys:String>
  <sys:String x:Key="Str.SupporterMissing">已選擇 {0}，但本機還沒有它的副本：請選擇你的 version.dll 或安裝程式。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} 需要 add-on v{1} 或更新：請在「Add-on 版本」中選擇。在此之前會裝入下載版。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} 需要 OptiScaler {1} 或更新：請在「OptiScaler 版本」中選擇。在此之前會裝入下載版。</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">add-on 暫時無法執行 {0}：下載清單中還沒有它的修補程式。在此之前這裡會裝入下載版；OptiScaler 路線可以直接執行它。</sys:String>
  <sys:String x:Key="Str.SupporterKept">已驗證並保留：danielblnc 的執行階段 {0}。</sys:String>
  <sys:String x:Key="Str.SupporterRefused">無法使用該檔案。{0}</sys:String>
  <sys:String x:Key="Str.Checking">正在檢查此資料夾…</sys:String>
  <sys:String x:Key="Str.StepDownload">下載</sys:String>
  <sys:String x:Key="Str.StepVerify">驗證</sys:String>
  <sys:String x:Key="Str.StepInstall">安裝</sys:String>
  <sys:String x:Key="Str.StepDone">完成</sys:String>
  <sys:String x:Key="Str.Installing">正在安裝…</sys:String>
  <sys:String x:Key="Str.Removing">正在移除…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} 已裝好。啟動遊戲即可使用。</sys:String>
  <sys:String x:Key="Str.InstallWarn">已安裝到 {0}，下方有 {1} 則警告需要查看。</sys:String>
  <sys:String x:Key="Str.InstallFail">{0} 的安裝未完成。</sys:String>
  <sys:String x:Key="Str.UninstallOk">已從 {0} 移除。</sys:String>
  <sys:String x:Key="Str.UninstallWarn">已從 {0} 移除，下方有 {1} 則警告需要查看。</sys:String>
  <sys:String x:Key="Str.UninstallFail">無法從 {0} 移除全部內容。</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} 仍被視為已安裝：本程式的某個檔案無法移除。請關閉遊戲後再次解除安裝。</sys:String>
  <sys:String x:Key="Str.UninstallClean">已從 {0} 移除——其資料夾中不再留有本程式的任何東西。</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">已從 {0} 移除——只保留了你的設定：{1}。</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">把你的設定也刪除嗎？</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">本程式裝進 {0} 的東西已全部移除。以下設定檔保留了下來——裡面是你在疊加介面中所做的設定：</sys:String>
  <sys:String x:Key="Str.SettingsRemove">一併刪除</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">資料夾恢復到安裝前的樣子。</sys:String>
  <sys:String x:Key="Str.SettingsKeep">保留我的設定</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">留到下次安裝時使用。</sys:String>
  <sys:String x:Key="Str.ResultErrors">下方列出了 {0} 個問題。</sys:String>
  <sys:String x:Key="Str.DownloadFailed">檔案無法下載，因此沒有安裝任何東西。</sys:String>
  <sys:String x:Key="Str.Folder">資料夾</sys:String>
  <!-- Second layout pass -->
  <sys:String x:Key="Str.GameCount">{0} 款遊戲</sys:String>
  <sys:String x:Key="Str.UnknownApi">不明 API</sys:String>
  <sys:String x:Key="Str.Location">位置</sys:String>
  <sys:String x:Key="Str.Details">詳細資料</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} 行</sys:String>
  <sys:String x:Key="Str.PreflightOk">可以安裝</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">沒有任何阻礙。在下方選擇路線並按下「安裝」。</sys:String>
  <sys:String x:Key="Str.PreflightWarn">可以安裝，有 {0} 則提示需要查看</sys:String>
  <sys:String x:Key="Str.PreflightErr">此資料夾中發現 {0} 個問題</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">已安裝到此遊戲</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">啟動遊戲即可使用。再次安裝可重新整理檔案，解除安裝則移除它們。</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">已安裝，有可用更新</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">此遊戲中的檔案比本程式現在安裝的舊。更新會取代它們，你的設定保持不變。</sys:String>
  <sys:String x:Key="Str.SeeDetails">展開下方的「詳細資料」查看發現的內容。</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">add-on 對這台電腦的需求，在程式啟動時檢查。</sys:String>
  <sys:String x:Key="Str.SystemReady">這台電腦符合 add-on 的需求</sys:String>
  <sys:String x:Key="Str.SystemNotReady">這台電腦缺少 add-on 需要的東西</sys:String>
  <sys:String x:Key="Str.GpuOk">偵測到 Radeon</sys:String>
  <sys:String x:Key="Str.GpuBad">不是 Radeon</sys:String>
  <sys:String x:Key="Str.Missing">缺少</sys:String>
  <sys:String x:Key="Str.DriverHint">Windows 回報的顯示卡驅動程式版本。</sys:String>
  <sys:String x:Key="Str.FilesHint">只下載一次，依固定雜湊值驗證，所有遊戲共用。</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">已驗證</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">未下載</sys:String>
  <sys:String x:Key="Str.DownloadingShort">下載中…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">下載中 {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">語言、更新以及關於本程式。</sys:String>
  <sys:String x:Key="Str.LanguageHint">所有文字立即切換，無需重新啟動。</sys:String>
  <sys:String x:Key="Str.DataFolder">資料夾位置</sys:String>
  <!-- Routes: the names and notes Core carries in English, said in this language. -->
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D11 遊戲</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12 遊戲</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan 遊戲</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL 遊戲</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D11 遊戲，32 位元</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9 遊戲，32 位元</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8 遊戲，32 位元</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler：具備 DLSS、FSR 或 XeSS 的 D3D12 遊戲</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">把模擬器設為 Direct3D 11：在這個渲染器上神經網路能取得的最多——模擬器的深度，以及裝了配套效果時的動態資訊。注意個別遊戲的覆寫設定，它會悄悄蓋過全域設定。</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">實驗性。Vulkan 上的 ReShade 是全域層，不是代理 DLL：對 rpcs3.exe 執行它的安裝程式並選擇 Vulkan。Vulkan 上沒有深度，只有色彩與估算的動態。</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">最佳路線：只有在 D3D11 上，遊戲自己的動態向量會與深度一起送到神經網路。</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">降級。在 D3D12 上 add-on 能找到遊戲的深度，但找不到動態向量，因此神經網路只取得色彩與深度，動態靠估算。能用，但效果會打折扣。設定裡有 DLSS、FSR 或 XeSS 的遊戲更適合走 OptiScaler 路線。</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">建議用於 D3D12 遊戲。這會安裝 OptiScaler 而非 ReShade，它接管遊戲的 DLSS、FSR 或 XeSS，在其中執行神經網路，使用遊戲自己的深度與動態向量。遊戲必須提供其中一種超解析度技術，並在設定中開啟。進入遊戲後按 Insert，開啟 Neural 分頁並開啟 Enable NR；具備光線重建（Ray Reconstruction）的遊戲需要把處理點設為 "After the finished frame"。</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">實驗性。Vulkan 上的 ReShade 是全域層：對遊戲的 .exe 執行它的安裝程式並選擇 Vulkan。遊戲必須靜態匯入 vkCreateDevice，而且 Vulkan 上沒有深度。</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">實驗性。與 Vulkan 不同，這是一般的代理 DLL：ReShade 以 opengl32.dll 放在遊戲旁邊，無需另外執行安裝程式。只有色彩與估算的動態；這個 API 上可以取得遊戲自己的深度，但尚未接上。32 位元 OpenGL 遊戲沒有路線。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">實驗性。32 位元遊戲無法載入 64 位元執行階段，所以 add-on 以一對處理程序執行，在同一張顯示卡上共用影格。以 32 位元 dxgi.dll 安裝具 add-on 支援的 ReShade。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">實驗性。與 D3D11 相同的 32 位元處理程序對，經過一個私有的 D3D9/D3D11 階段。一般 D3D9 每個影格有固定幾毫秒的額外負擔；D3D9Ex 沒有。以 32 位元 d3d9.dll 安裝 ReShade。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">實驗性。D3D8 先轉換為 D3D9，再走上方的 D3D9 路線，使用同樣的 32 位元處理程序對。以 32 位元 d3d9.dll 安裝 ReShade。</sys:String>

  <!-- First run -->
  <sys:String x:Key="Str.SetupWelcome">歡迎</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">透過 ReShade 或 OptiScaler，在 Radeon 顯示卡上執行 DLSS 5 神經渲染網路。只需四個簡單步驟。</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">本機</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">檔案</sys:String>
  <sys:String x:Key="Str.SetupStepGames">你的遊戲</sys:String>
  <sys:String x:Key="Str.SetupBack">上一步</sys:String>
  <sys:String x:Key="Str.SetupNext">繼續</sys:String>
  <sys:String x:Key="Str.SetupFinish">開始使用</sys:String>
  <sys:String x:Key="Str.SetupSkip">暫時略過</sys:String>
  <sys:String x:Key="Str.SetupStepOf">第 {0} 步，共 {1} 步</sys:String>

  <sys:String x:Key="Str.SetupMachineBody">有兩樣東西會導致 add-on 無法執行，在這裡都看得到。它們都不會阻止你繼續——只會讓它在遊戲裡無法運作。</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">這台電腦具備 add-on 需要的一切。</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">缺少某些東西。你可以先繼續、稍後再修正，但修正之前它在遊戲裡無法運作。</sys:String>

  <sys:String x:Key="Str.SetupFilesBody">所有遊戲共用同一批檔案：只下載一次，依固定雜湊值驗證，重複使用。</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">再試一次</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">略過的話，會在第一次安裝時下載。</sys:String>

  <sys:String x:Key="Str.SetupGamesBody">讀取啟動器是唯讀的：查看不會安裝或變更任何東西。之後也可以手動新增資料夾。</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">每款遊戲都會被讀取以判斷它使用哪種圖形 API，結果通常正確，但並非總是如此：一個資料夾裡可能同時有 D3D11 和 D3D12 的執行檔，遊戲也可能預設使用一種 API，而執行檔同時支援較舊的一種。安裝前最好在 pcgamingwiki.com 上查一下——每張遊戲卡片上都有直達連結。</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">找不到遊戲。你可以在主視窗中手動新增資料夾。</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">找到 {0} 款遊戲。</sys:String>

  <sys:String x:Key="Str.Unexpected">發生了未預期的錯誤，已寫入完整記錄檔。</sys:String>


  <!-- Play and emulators -->
  <sys:String x:Key="Str.Play">開始遊戲</sys:String>
  <sys:String x:Key="Str.Launch">開啟</sys:String>
  <sys:String x:Key="Str.PlayFailed">無法啟動。請用「開啟資料夾」，手動執行執行檔。</sys:String>
  <sys:String x:Key="Str.AddEmulator">新增模擬器</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">新增模擬器</sys:String>
  <sys:String x:Key="Str.EmulatorBody">先選擇是哪一個，再指向它執行所在的資料夾——放執行檔的那個，不是放 ROM 的那個。</sys:String>
  <sys:String x:Key="Str.EmulatorOther">其他模擬器</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">指向該資料夾，我會告訴你能從中判斷出什麼。</sys:String>
  <sys:String x:Key="Str.EmulatorPick">指向 {0} 的資料夾</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">指向模擬器的資料夾</sys:String>
  <sys:String x:Key="Str.EmulatorFound">找到 {0}：{1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">這看起來不像 {0}：該資料夾裡沒有 {1}。仍已新增——請檢查路徑。</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">裡面沒有我認得的模擬器。已依檔案資訊新增：{0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">在模擬器中</sys:String>

  <!-- Emulator guidance: the menu path stays in English, as the emulator itself shows it. -->
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer：Direct3D 11。注意遊戲內容裡的個別設定——它會悄悄蓋過全域設定，也是「看起來壞了其實沒壞」最常見的原因。</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer：Vulkan。這裡完全沒有 Direct3D，所以此路線只取得色彩與估算的動態——沒有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer：Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend：Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend：Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API：DirectX 11。</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">它在 D3D12 上執行，這是降級路線：add-on 只能看到最終畫面。能用，但效果會打折扣。</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API：Vulkan。Vulkan 上沒有深度：只有色彩與估算的動態。</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend：Vulkan。Vulkan 上沒有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan 是預設後端。Vulkan 上沒有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">僅支援 Vulkan。沒有深度，而且模擬器本身還很早期——可能會遇到問題。</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API：Vulkan。OpenGL 現在也有路線了，但 Vulkan 這條經過了更多實測。</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu 只用 OpenGL 渲染，所以這裡只有 OpenGL 路線。它是最新的路線，屬於實驗性：色彩與估算的動態，沒有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer：OpenGL。軟體渲染器在 CPU 上繪製，add-on 無從介入，所以必須用 OpenGL——而這條路線是實驗性的：色彩與估算的動態，沒有深度。</sys:String>


  <!-- Problem report -->
  <sys:String x:Key="Str.ReportTitle">在遊戲裡沒有作用？</sys:String>
  <sys:String x:Key="Str.ReportBody">把記錄檔、遊戲資料夾裡的內容以及 ReShade 寫出的資訊收集成一個 .zip。不會上傳任何東西：檔案留在你的電腦上，由你決定分享到哪裡。</sys:String>
  <sys:String x:Key="Str.Report">回報問題</sys:String>
  <sys:String x:Key="Str.ReportSaved">回報已儲存並開啟所在資料夾：{0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">無法產生回報。記錄檔位於 {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">收集中…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">檔案下載不了？</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">收集每次下載的嘗試記錄——每個位址、名稱解析、Proxy 與回應——並立即重新檢測每個位址，打包成一個 .zip。不會上傳任何東西：檔案留在你的電腦上，由你決定分享到哪裡。</sys:String>
  <sys:String x:Key="Str.DownloadReport">下載記錄檔</sys:String>

  <!-- The sheet's two routes, the files panel, updates. -->
  <sys:String x:Key="Str.Add">新增</sys:String>
  <sys:String x:Key="Str.AddMenuMany">在資料夾中搜尋遊戲…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">單一遊戲的資料夾…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">模擬器…</sys:String>
  <sys:String x:Key="Str.UpdateShort">更新</sys:String>
  <sys:String x:Key="Str.GamesAway">{0} 款在未連接的磁碟上</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">位於目前未連接磁碟上的遊戲會被記住，包括為它們做的所有選擇，磁碟重新接上後就會回來。</sys:String>
  <sys:String x:Key="Str.GameGone">{0} 已不再安裝，因此已從清單移除。</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} 款遊戲已不再安裝，因此已從清單移除。</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} 款遊戲已不再安裝，因此已從清單移除。</sys:String>
  <sys:String x:Key="Str.ShowDetails">顯示詳細資料</sys:String>
  <sys:String x:Key="Str.DetectedSection">偵測結果</sys:String>
  <sys:String x:Key="Str.CheckApiTip">檔案只說明遊戲連結了什麼，而不是它實際在什麼上執行：一個資料夾裡可能同時有 D3D11 和 D3D12 的執行檔。Wiki 會說明遊戲實際使用哪個。</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">從遊戲本身的檔案讀取。</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">來自 PCGamingWiki 與遊戲檔案。</sys:String>
  <sys:String x:Key="Str.InstallWith">安裝方式</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + add-on</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">建議</sys:String>
  <sys:String x:Key="Str.RecommendedLower">建議</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">ReShade 內的 add-on。支援 D3D11、D3D12、Vulkan、OpenGL、32 位元遊戲與模擬器。</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">此遊戲辨識為 {0}，沒有對應的 ReShade 路線。</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">在遊戲的 DLSS、FSR 或 XeSS 內執行，使用遊戲自己的深度與動態資訊。取代 ReShade。</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">在遊戲的超解析度技術內執行（此處找到 {0}）。取代 ReShade。</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">專為 64 位元 D3D12 遊戲設計；此遊戲辨識為 {0}。</sys:String>
  <sys:String x:Key="Str.ApiSection">圖形 API</sys:String>
  <sys:String x:Key="Str.Group64">64 位元遊戲</sys:String>
  <sys:String x:Key="Str.Group32">32 位元遊戲（實驗性）</sys:String>
  <sys:String x:Key="Str.GroupEmulators">模擬器</sys:String>
  <sys:String x:Key="Str.OptiAbout">這會安裝 OptiScaler 而非 ReShade，它接管遊戲的 DLSS、FSR 或 XeSS，在其中執行神經網路，使用遊戲自己的深度與動態向量。</sys:String>
  <sys:String x:Key="Str.InGame">在遊戲中</sys:String>
  <sys:String x:Key="Str.OptiStep1">在遊戲的圖形設定中開啟 DLSS、FSR 或 XeSS。</sys:String>
  <sys:String x:Key="Str.OptiStep2">按 Insert，開啟 Neural 分頁並開啟 Enable NR。</sys:String>
  <sys:String x:Key="Str.OptiStep3">若開啟了光線重建（Ray Reconstruction），把處理點設為 "After the finished frame"。</sys:String>
  <sys:String x:Key="Str.InstallOpti">安裝 OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">更新</sys:String>
  <sys:String x:Key="Str.Reinstall">重新安裝</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">切換到 OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">切換到 ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">切換到 {0}？</sys:String>
  <sys:String x:Key="Str.SwitchBody">{0} 已安裝 {1} 路線，兩者不能同時存在於一個資料夾。會先移除 {1} 並還原它取代過的檔案，然後安裝 {2}。</sys:String>
  <sys:String x:Key="Str.SwitchYes">移除 {0}，安裝 {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">你自己的設定檔保持原樣。</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">不做任何變更；{0} 保持安裝。</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">原因見「詳細資料」。沒有安裝任何東西。</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">也可以用瀏覽器下載檔案後匯入：本機 &gt; 檔案 &gt; 手動下載，然後按「匯入檔案」。「下載」資料夾中的檔案會被自動找到。</sys:String>
  <sys:String x:Key="Str.DnsRetry">清除 DNS 並再試一次</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows 不允許從這裡清除 DNS 快取。請開啟命令提示字元，執行 ipconfig /flushdns，然後再試一次。</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">此資料夾中發現 {0} 個問題</sys:String>
