<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.SimplifiedChinese">

  <!-- The window font. Inter carries the Latin text; a CJK face after it carries the rest. -->
  <FontFamily x:Key="AppFont">Inter, Microsoft YaHei UI, Microsoft YaHei, sans-serif</FontFamily>

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">在 Radeon 上运行 DLSS 5 神经渲染，一键装好</sys:String>

  <sys:String x:Key="Str.Games">游戏</sys:String>
  <sys:String x:Key="Str.RemoveGame">从列表移除</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">只把这一行从列表中移除，游戏文件夹里的文件不会被动到。</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} 已从列表移除，它的文件夹里没有任何改动。</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} 已从列表移除，但 add-on 仍装在它的文件夹里。如需卸载，请把该文件夹重新添加回来。</sys:String>
  <sys:String x:Key="Str.NoGames">这里还没有内容。请添加游戏或模拟器运行所在的文件夹。</sys:String>
  <sys:String x:Key="Str.PickFolder">选择游戏运行所在的文件夹</sys:String>
  <sys:String x:Key="Str.AddGameMany">搜索文件夹</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">选择存放游戏的文件夹</sys:String>
  <sys:String x:Key="Str.AddGameNone">在“{0}”下没有找到像游戏的内容。</sys:String>

  <sys:String x:Key="Str.Preset">路线</sys:String>
  <sys:String x:Key="Str.Install">安装</sys:String>
  <sys:String x:Key="Str.Uninstall">卸载</sys:String>
  <sys:String x:Key="Str.OpenFolder">打开文件夹</sys:String>

  <sys:String x:Key="Str.System">本机</sys:String>
  <sys:String x:Key="Str.Gpu">显卡</sys:String>
  <sys:String x:Key="Str.Driver">驱动</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 运行时</sys:String>
  <sys:String x:Key="Str.HipMissing">未找到 amdhip64_7.dll。新版 Adrenalin 驱动自带它；HIP 6 不行。</sys:String>
  <sys:String x:Key="Str.NotRadeon">这看起来不是 Radeon 显卡。该神经网络仅支持 RDNA3 和 RDNA4。</sys:String>
  <sys:String x:Key="Str.Ready">就绪</sys:String>

  <sys:String x:Key="Str.Payloads">文件</sys:String>
  <sys:String x:Key="Str.Downloading">正在下载</sys:String>
  <sys:String x:Key="Str.Verifying">正在校验已有文件…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">已下载并校验。</sys:String>
  <sys:String x:Key="Str.ManifestLocal">无法读取已发布的下载列表，正在使用本应用自带的副本。</sys:String>
  <sys:String x:Key="Str.ManifestFailed">无法读取下载列表。请检查网络连接后重试。</sys:String>

  <sys:String x:Key="Str.Language">语言</sys:String>
  <sys:String x:Key="Str.UpdateWorking">正在下载更新…</sys:String>
  <sys:String x:Key="Str.Dismiss">以后再说</sys:String>

  <sys:String x:Key="Str.LogSaved">完整日志已写入本应用所在目录。</sys:String>
  <sys:String x:Key="Str.Working">处理中…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">游戏列表无法读取。原文件已另存为旁边的 {0}，并新建了一份列表。</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">仍在写入游戏文件夹，需要几秒钟；完成后再关闭窗口。</sys:String>
  <sys:String x:Key="Str.FreeTitle">本软件免费。如果你为它付了钱，你被骗了。</sys:String>
  <sys:String x:Key="Str.FreeBody">这里的一切都不收费——安装器、add-on、运行时、模型权重都不卖。如果有人向你收费，或卖你“激活码”“专业版”，请要求退款：他们卖给你的东西在这个页面上都是免费的。</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">它是开源的，并将一直开源：你可以阅读、修改、自行构建、分享给朋友。我们唯一的请求是：不要把它变成付费版本。</sys:String>
  <sys:String x:Key="Str.SupportSection">支持</sys:String>
  <sys:String x:Key="Str.SupportNote">自愿的，不会换来任何额外功能</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">请喝一杯咖啡。</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">本项目在巴西的募款。</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — 作者 danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">神经网络本身，也是这一切存在的原因：正是它让 DLSS 5 的神经渲染得以在 Radeon 上运行。本应用下载的运行时和模型权重都是他的成果，不是我们的。谢谢你，danielblnc。</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">通过 ReShade 把该神经网络接入游戏的部分：即本应用安装的 add-on，以及可供你选择的各个发布版本。MIT 许可，与本安装器是不同的仓库。</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — 大家都在这里</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">新版本、哪些游戏能用，以及出问题时去哪里提问。</sys:String>
  <sys:String x:Key="Str.CreditsSection">致谢</sys:String>

  <sys:String x:Key="Str.Scan">扫描游戏</sys:String>
  <sys:String x:Key="Str.Scanning">正在读取 Steam、Epic、GOG、EA、Ubisoft、Battle.net 和 Xbox…</sys:String>
  <sys:String x:Key="Str.Search">搜索游戏…</sys:String>
  <sys:String x:Key="Str.Settings">设置</sys:String>
  <sys:String x:Key="Str.WillDownload">文件会在安装时下载并校验。</sys:String>
  <sys:String x:Key="Str.NoRoute">这个游戏使用的渲染方式都没有可用路线：add-on 支持 D3D11、D3D12、Vulkan 和 OpenGL，32 位游戏支持 D3D8、D3D9 和 D3D11。32 位 OpenGL 游戏、64 位 D3D9 游戏和软件渲染器都不支持。</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">这个游戏可以运行在 {1} 上。请在游戏自身的图形设置里改为 {0}——这是此处选定的路线；换成其他 API，add-on 看到的就是另一回事了。</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">这是虚幻引擎游戏：在启动选项里加上 -{0}。</sys:String>
  <sys:String x:Key="Str.CheckWiki">在 PCGamingWiki 上查看这个游戏</sys:String>
  <!-- Feedback and layout -->
  <sys:String x:Key="Str.EmptyTitle">还没有游戏</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">无匹配结果</sys:String>
  <sys:String x:Key="Str.NoMatch">列表中没有匹配“{0}”的游戏。</sys:String>
  <sys:String x:Key="Str.ScanningShort">扫描中…</sys:String>
  <sys:String x:Key="Str.ScanDone">扫描完成：找到 {0} 个游戏，其中 {1} 个是新的。</sys:String>
  <sys:String x:Key="Str.InstalledBadge">已安装</sys:String>
  <sys:String x:Key="Str.Close">关闭</sys:String>
  <sys:String x:Key="Str.CloseHint">关闭 (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">游戏的可执行文件</sys:String>
  <sys:String x:Key="Str.ExeChoose">选择…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">使用检测到的文件</sys:String>
  <sys:String x:Key="Str.ExeNone">此文件夹中未找到可执行文件。</sys:String>
  <sys:String x:Key="Str.ExeNote">位数和 API 从这个文件读取，下面的路线也由它决定。有的游戏在根目录放一个小启动器、真正的程序在 Bin64 里，这种情况会判断错——如果这里的位数不是你预期的，请指向正确的文件。</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">这个文件是你选的，检测不会再改动它——重新扫描后也不会。</sys:String>
  <sys:String x:Key="Str.ExeNotHere">该文件不在这个游戏的文件夹里。</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">该文件不是可读取的 Windows 可执行文件。</sys:String>
  <sys:String x:Key="Str.RouteMismatch">此路线适用于 {0} 游戏，而上面的可执行文件是 {1}。你仍可继续——检测可能读错了文件——但如果没读错，这样装了也不会加载。</sys:String>
  <sys:String x:Key="Str.VersionSection">Add-on 版本</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade 加载为</sys:String>
  <sys:String x:Key="Str.ProxyNote">“自动”会选 dxgi.dll，适用于所有 Direct3D。只有当游戏不肯加载它时才换别的——有些游戏只加载 d3d12.dll。</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler 加载为</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">“自动”会选 dxgi.dll。如果 dxgi.dll 必须留给别的东西（比如你想保留的 ReShade），请选 winmm.dll。</sys:String>
  <sys:String x:Key="Str.ProxyAuto">自动</sys:String>
  <sys:String x:Key="Str.PrefetchAll">立即全部下载</sys:String>
  <sys:String x:Key="Str.ClearCache">清除缓存</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">删除已下载的文件、封面和版本列表。已装进游戏的内容不受影响；下次安装时会重新下载所需文件。</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">清除</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">其中的所有内容会在下次安装时重新下载。</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">保持缓存不变。</sys:String>
  <sys:String x:Key="Str.CacheCleared">缓存已清空——释放了 {0}。</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">所有文件都已存在，并且刚刚全部校验通过。</sys:String>
  <sys:String x:Key="Str.VersionShipped">内置</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">本安装器发布时附带的版本。</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">取自 GitHub 上的 v{0} 发布版，并按该版本公布的哈希校验。</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler 版本</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}，取自其 GitHub 发布版。其中每个文件都按下载列表给出的哈希校验。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">它还会安装 lmxxf 运行时的模型权重，约 590 MB，仅 RDNA4 显卡会用到。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">它也可以带上 mochizuki 运行时：见下方的 NR 运行时。</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR 运行时</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">同时安装 mochizuki，作为第二个 NR 运行时（实验性）</sys:String>
  <sys:String x:Key="Str.MochizukiNote">由 mochizuki0323 移植到 Vulkan 的 DLSS 5 神经网络。仅限 RDNA4：RX 9000 系列，AMD 驱动 25.10 或更新。它会添加 MochizukiNrRuntime.dll 和一个包含模型的 dlssnr-amd 文件夹，约需下载 141 MB。NR 运行时仍是 danielblnc 的：要使用 mochizuki，请在 OptiScaler 的 Neural 标签页的 NR runtime 中选择它，然后重启游戏。每个游戏首次启动时会花几秒钟编译神经网络。取消勾选后，下次安装会移除本应用装入的相关文件。</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">同时安装 mochizuki，作为第二个 NR 运行时（实验性）</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">由 mochizuki0323 移植到 Vulkan 的 DLSS 5 神经网络，add-on 从 v0.6.8 起可用它替代 danielblnc 的运行时。仅限 RDNA4：RX 9000 系列，AMD 驱动 25.10 或更新。它会添加 MochizukiNrRuntime.dll 和一个包含模型的 dlssnr-amd 文件夹，约需下载 141 MB。要使用它，请在 add-on 面板的 NR runtime 中选择 mochizuki (Vulkan)，然后重启游戏。每个游戏首次启动时最多需要一分钟编译神经网络。取消勾选后，下次安装会移除本应用装入的相关文件。</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">此显卡 ({0}) 不提供：mochizuki 需要 RDNA4（RX 9000 系列）的 FP8 矩阵指令。</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">本应用无法识别这是哪块显卡；除 RX 9000 系列外，mochizuki 在游戏里都不会启用。</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">选择安装路线</sys:String>
  <sys:String x:Key="Str.PickRouteBody">本应用无法判断 {0} 使用哪种图形 API，因此不会替你选路线。设置里提供 DLSS、FSR 或 XeSS 的 D3D12 游戏选 OptiScaler；其他游戏（D3D11 或 D3D12）选 ReShade。在你选择之前无法安装。</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">图形 API 未知，请在下方自行选择路线。</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc 的运行时</sys:String>
  <sys:String x:Key="Str.SupporterChoose">这个游戏可以装两个版本之一。请选择：高亮的那个会被装入。</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">公开发布版 ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">由本应用为你下载并校验，无需自己提供任何文件。</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">本地赞助者版 ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">选择我的 version.dll 或安装程序…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">选择其他文件…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">比公开发布版更新，来自你自己的 version.dll 或 dlssnr_on_amd_setup.exe。</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 增加了 RDNA3 显卡的内核。</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">赞助者版不对外分发：本应用从不下载它，其作者也不公开提供。你的文件每次装入时都会按 SHA-256 校验，并保留一份校验过的副本，其他游戏就不必再次索要。</sys:String>
  <sys:String x:Key="Str.SupporterUse">使用我的赞助者文件…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">公开发布版</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">你的 version.dll 或 dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">任意 DLL 或安装程序</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">当前使用：本应用下载的运行时。</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">正在使用你文件中的 {0}。</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">正在使用 {0}：这是你之前选择时本应用保留的校验副本。</sys:String>
  <sys:String x:Key="Str.SupporterMissing">已选择 {0}，但本机还没有它的副本：请选择你的 version.dll 或安装程序。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} 需要 add-on v{1} 或更新：请在“Add-on 版本”中选择。在此之前会装入下载版。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} 需要 OptiScaler {1} 或更新：请在“OptiScaler 版本”中选择。在此之前会装入下载版。</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">add-on 暂时无法运行 {0}：下载列表中还没有它的补丁。在此之前这里会装入下载版；OptiScaler 路线可以直接运行它。</sys:String>
  <sys:String x:Key="Str.SupporterKept">已校验并保留：danielblnc 的运行时 {0}。</sys:String>
  <sys:String x:Key="Str.SupporterRefused">无法使用该文件。{0}</sys:String>
  <sys:String x:Key="Str.Checking">正在检查此文件夹…</sys:String>
  <sys:String x:Key="Str.StepDownload">下载</sys:String>
  <sys:String x:Key="Str.StepVerify">校验</sys:String>
  <sys:String x:Key="Str.StepInstall">安装</sys:String>
  <sys:String x:Key="Str.StepDone">完成</sys:String>
  <sys:String x:Key="Str.Installing">正在安装…</sys:String>
  <sys:String x:Key="Str.Removing">正在移除…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} 已装好。启动游戏即可使用。</sys:String>
  <sys:String x:Key="Str.InstallWarn">已安装到 {0}，下方有 {1} 条警告需要查看。</sys:String>
  <sys:String x:Key="Str.InstallFail">{0} 的安装未完成。</sys:String>
  <sys:String x:Key="Str.UninstallOk">已从 {0} 移除。</sys:String>
  <sys:String x:Key="Str.UninstallWarn">已从 {0} 移除，下方有 {1} 条警告需要查看。</sys:String>
  <sys:String x:Key="Str.UninstallFail">无法从 {0} 移除全部内容。</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} 仍被视为已安装：本应用的某个文件无法移除。请关闭游戏后再次卸载。</sys:String>
  <sys:String x:Key="Str.UninstallClean">已从 {0} 移除——其文件夹中不再留有本应用的任何东西。</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">已从 {0} 移除——只保留了你的设置：{1}。</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">把你的设置也删除吗？</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">本应用装进 {0} 的东西已全部移除。以下设置文件保留了下来——里面是你在覆盖层中所做的设置：</sys:String>
  <sys:String x:Key="Str.SettingsRemove">一并删除</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">文件夹恢复到安装前的样子。</sys:String>
  <sys:String x:Key="Str.SettingsKeep">保留我的设置</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">留到下次安装时使用。</sys:String>
  <sys:String x:Key="Str.ResultErrors">下方列出了 {0} 个问题。</sys:String>
  <sys:String x:Key="Str.DownloadFailed">文件无法下载，因此没有安装任何东西。</sys:String>
  <sys:String x:Key="Str.Folder">文件夹</sys:String>
  <!-- Second layout pass -->
  <sys:String x:Key="Str.GameCount">{0} 个游戏</sys:String>
  <sys:String x:Key="Str.UnknownApi">未知 API</sys:String>
  <sys:String x:Key="Str.Location">位置</sys:String>
  <sys:String x:Key="Str.Details">详情</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} 行</sys:String>
  <sys:String x:Key="Str.PreflightOk">可以安装</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">没有任何阻碍。在下方选择路线并点击“安装”。</sys:String>
  <sys:String x:Key="Str.PreflightWarn">可以安装，有 {0} 条提示需要查看</sys:String>
  <sys:String x:Key="Str.PreflightErr">此文件夹中发现 {0} 个问题</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">已安装到此游戏</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">启动游戏即可使用。再次安装可刷新文件，卸载则移除它们。</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">已安装，有可用更新</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">此游戏中的文件比本应用现在安装的旧。更新会替换它们，你的设置保持不变。</sys:String>
  <sys:String x:Key="Str.SeeDetails">展开下方的“详情”查看发现的内容。</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">add-on 对这台电脑的要求，在应用启动时检查。</sys:String>
  <sys:String x:Key="Str.SystemReady">这台电脑满足 add-on 的要求</sys:String>
  <sys:String x:Key="Str.SystemNotReady">这台电脑缺少 add-on 需要的东西</sys:String>
  <sys:String x:Key="Str.GpuOk">检测到 Radeon</sys:String>
  <sys:String x:Key="Str.GpuBad">不是 Radeon</sys:String>
  <sys:String x:Key="Str.Missing">缺失</sys:String>
  <sys:String x:Key="Str.DriverHint">Windows 报告的显卡驱动版本。</sys:String>
  <sys:String x:Key="Str.FilesHint">只下载一次，按固定哈希校验，所有游戏共用。</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">已校验</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">未下载</sys:String>
  <sys:String x:Key="Str.DownloadingShort">下载中…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">下载中 {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">语言、更新以及关于本应用。</sys:String>
  <sys:String x:Key="Str.LanguageHint">所有文字立即切换，无需重启。</sys:String>
  <sys:String x:Key="Str.DataFolder">数据文件夹</sys:String>
  <!-- Routes: the names and notes Core carries in English, said in this language. -->
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D11 游戏</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12 游戏</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan 游戏</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL 游戏</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D11 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler：带 DLSS、FSR 或 XeSS 的 D3D12 游戏</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">把模拟器设为 Direct3D 11：在这个渲染器上神经网络能拿到的最多——模拟器的深度，以及装了配套效果时的运动信息。注意单个游戏的覆盖设置，它会悄悄压过全局设置。</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">实验性。Vulkan 上的 ReShade 是全局层，不是代理 DLL：对 rpcs3.exe 运行它的安装程序并选择 Vulkan。Vulkan 上没有深度，只有颜色和估算的运动。</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">最佳路线：只有在 D3D11 上，游戏自己的运动矢量会和深度一起送到神经网络。</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">降级。在 D3D12 上 add-on 能找到游戏的深度，但找不到运动矢量，因此神经网络只拿到颜色和深度，运动靠估算。能用，但效果会打折扣。设置里有 DLSS、FSR 或 XeSS 的游戏更适合走 OptiScaler 路线。</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">推荐用于 D3D12 游戏。这会安装 OptiScaler 而不是 ReShade，它接管游戏的 DLSS、FSR 或 XeSS，在其中运行神经网络，使用游戏自己的深度和运动矢量。游戏必须提供其中一种超分，并在设置中开启。进入游戏后按 Insert，打开 Neural 标签页并开启 Enable NR；带光线重建（Ray Reconstruction）的游戏需要把处理点设为 "After the finished frame"。</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">实验性。Vulkan 上的 ReShade 是全局层：对游戏的 .exe 运行它的安装程序并选择 Vulkan。游戏必须静态导入 vkCreateDevice，并且 Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">实验性。与 Vulkan 不同，这是普通的代理 DLL：ReShade 以 opengl32.dll 放在游戏旁边，无需单独运行安装程序。只有颜色和估算的运动；这个 API 上可以拿到游戏自己的深度，但尚未接入。32 位 OpenGL 游戏没有路线。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">实验性。32 位游戏无法加载 64 位运行时，所以 add-on 以一对进程运行，在同一块显卡上共享帧。以 32 位 dxgi.dll 安装带 add-on 支持的 ReShade。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">实验性。与 D3D11 相同的 32 位进程对，经过一个私有的 D3D9/D3D11 阶段。普通 D3D9 每帧有固定几毫秒的开销；D3D9Ex 没有。以 32 位 d3d9.dll 安装 ReShade。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">实验性。D3D8 先转换为 D3D9，再走上面的 D3D9 路线，使用同样的 32 位进程对。以 32 位 d3d9.dll 安装 ReShade。</sys:String>

  <!-- First run -->
  <sys:String x:Key="Str.SetupWelcome">欢迎</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">通过 ReShade 或 OptiScaler，在 Radeon 显卡上运行 DLSS 5 神经渲染网络。只需四个简单步骤。</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">本机</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">文件</sys:String>
  <sys:String x:Key="Str.SetupStepGames">你的游戏</sys:String>
  <sys:String x:Key="Str.SetupBack">返回</sys:String>
  <sys:String x:Key="Str.SetupNext">继续</sys:String>
  <sys:String x:Key="Str.SetupFinish">开始使用</sys:String>
  <sys:String x:Key="Str.SetupSkip">暂时跳过</sys:String>
  <sys:String x:Key="Str.SetupStepOf">第 {0} 步，共 {1} 步</sys:String>

  <sys:String x:Key="Str.SetupMachineBody">有两样东西会导致 add-on 无法运行，在这里都能看到。它们都不会阻止你继续——只会让它在游戏里无法工作。</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">这台电脑具备 add-on 需要的一切。</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">缺少某些东西。你可以先继续、稍后再修复，但修复之前它在游戏里无法工作。</sys:String>

  <sys:String x:Key="Str.SetupFilesBody">所有游戏共用同一批文件：只下载一次，按固定哈希校验，重复使用。</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">重试</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">跳过的话，会在第一次安装时下载。</sys:String>

  <sys:String x:Key="Str.SetupGamesBody">读取启动器是只读的：查看不会安装或修改任何东西。之后也可以手动添加文件夹。</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">每个游戏都会被读取以判断它使用哪种图形 API，结果通常正确，但并非总是如此：一个文件夹里可能同时有 D3D11 和 D3D12 的可执行文件，游戏也可能默认使用一种 API，而可执行文件同时支持更旧的一种。安装前最好在 pcgamingwiki.com 上查一下——每张游戏卡片上都有直达链接。</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">未找到游戏。你可以在主窗口中手动添加文件夹。</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">找到 {0} 个游戏。</sys:String>

  <sys:String x:Key="Str.Unexpected">发生了意外错误，已写入完整日志。</sys:String>


  <!-- Play and emulators -->
  <sys:String x:Key="Str.Play">开始游戏</sys:String>
  <sys:String x:Key="Str.Launch">打开</sys:String>
  <sys:String x:Key="Str.PlayFailed">无法启动。请用“打开文件夹”，手动运行可执行文件。</sys:String>
  <sys:String x:Key="Str.AddEmulator">添加模拟器</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">添加模拟器</sys:String>
  <sys:String x:Key="Str.EmulatorBody">先选择是哪一个，再指向它运行所在的文件夹——放可执行文件的那个，不是放 ROM 的那个。</sys:String>
  <sys:String x:Key="Str.EmulatorOther">其他模拟器</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">指向该文件夹，我会告诉你能从中判断出什么。</sys:String>
  <sys:String x:Key="Str.EmulatorPick">指向 {0} 的文件夹</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">指向模拟器的文件夹</sys:String>
  <sys:String x:Key="Str.EmulatorFound">找到 {0}：{1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">这看起来不像 {0}：该文件夹里没有 {1}。仍已添加——请检查路径。</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">里面没有我认识的模拟器。已按文件信息添加：{0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">在模拟器中</sys:String>

  <!-- Emulator guidance: the menu path stays in English, as the emulator itself shows it. -->
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer：Direct3D 11。注意游戏属性里的单独设置——它会悄悄压过全局设置，也是“看起来坏了其实没坏”最常见的原因。</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer：Vulkan。这里完全没有 Direct3D，所以此路线只拿到颜色和估算的运动——没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer：Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend：Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend：Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API：DirectX 11。</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">它运行在 D3D12 上，这是降级路线：add-on 只能看到最终画面。能用，但效果会打折扣。</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API：Vulkan。Vulkan 上没有深度：只有颜色和估算的运动。</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend：Vulkan。Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan 是默认后端。Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">仅支持 Vulkan。没有深度，而且模拟器本身还很早期——可能会遇到问题。</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API：Vulkan。OpenGL 现在也有路线了，但 Vulkan 这条经过了更多实测。</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu 只用 OpenGL 渲染，所以这里只有 OpenGL 路线。它是最新的路线，属于实验性：颜色和估算的运动，没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer：OpenGL。软件渲染器在 CPU 上绘制，add-on 无从介入，所以必须用 OpenGL——而这条路线是实验性的：颜色和估算的运动，没有深度。</sys:String>


  <!-- Problem report -->
  <sys:String x:Key="Str.ReportTitle">在游戏里不起作用？</sys:String>
  <sys:String x:Key="Str.ReportBody">把日志、游戏文件夹里的内容以及 ReShade 写出的信息收集成一个 .zip。不会上传任何东西：文件留在你的电脑上，由你决定分享到哪里。</sys:String>
  <sys:String x:Key="Str.Report">报告问题</sys:String>
  <sys:String x:Key="Str.ReportSaved">报告已保存并打开所在文件夹：{0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">无法生成报告。日志位于 {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">收集中…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">文件下载不了？</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">收集每次下载的尝试记录——每个地址、域名解析、代理和响应——并立即重新检测每个地址，打包成一个 .zip。不会上传任何东西：文件留在你的电脑上，由你决定分享到哪里。</sys:String>
  <sys:String x:Key="Str.DownloadReport">下载日志</sys:String>

  <!-- The sheet's two routes, the files panel, updates. -->
  <sys:String x:Key="Str.Add">添加</sys:String>
  <sys:String x:Key="Str.AddMenuMany">在文件夹中搜索游戏…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">单个游戏的文件夹…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">模拟器…</sys:String>
  <sys:String x:Key="Str.UpdateShort">更新</sys:String>
  <sys:String x:Key="Str.GamesAway">{0} 个在未连接的磁盘上</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">位于当前未连接磁盘上的游戏会被记住，包括为它们做的所有选择，磁盘重新接入后就会回来。</sys:String>
  <sys:String x:Key="Str.GameGone">{0} 已不再安装，因此已从列表移除。</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} 个游戏已不再安装，因此已从列表移除。</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} 个游戏已不再安装，因此已从列表移除。</sys:String>
  <sys:String x:Key="Str.ShowDetails">显示详情</sys:String>
  <sys:String x:Key="Str.DetectedSection">检测结果</sys:String>
  <sys:String x:Key="Str.CheckApiTip">文件只说明游戏链接了什么，而不是它实际运行在什么上：一个文件夹里可能同时有 D3D11 和 D3D12 的可执行文件。Wiki 会说明游戏实际使用哪个。</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">从游戏自身的文件中读取。</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">来自 PCGamingWiki 和游戏文件。</sys:String>
  <sys:String x:Key="Str.InstallWith">安装方式</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + add-on</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">推荐</sys:String>
  <sys:String x:Key="Str.RecommendedLower">推荐</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">ReShade 内的 add-on。支持 D3D11、D3D12、Vulkan、OpenGL、32 位游戏和模拟器。</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">此游戏识别为 {0}，没有对应的 ReShade 路线。</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">在游戏的 DLSS、FSR 或 XeSS 内运行，使用游戏自己的深度和运动信息。替代 ReShade。</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">在游戏的超分内运行（此处找到 {0}）。替代 ReShade。</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">专为 64 位 D3D12 游戏设计；此游戏识别为 {0}。</sys:String>
  <sys:String x:Key="Str.ApiSection">图形 API</sys:String>
  <sys:String x:Key="Str.Group64">64 位游戏</sys:String>
  <sys:String x:Key="Str.Group32">32 位游戏（实验性）</sys:String>
  <sys:String x:Key="Str.GroupEmulators">模拟器</sys:String>
  <sys:String x:Key="Str.OptiAbout">这会安装 OptiScaler 而不是 ReShade，它接管游戏的 DLSS、FSR 或 XeSS，在其中运行神经网络，使用游戏自己的深度和运动矢量。</sys:String>
  <sys:String x:Key="Str.InGame">在游戏中</sys:String>
  <sys:String x:Key="Str.OptiStep1">在游戏的图形设置中开启 DLSS、FSR 或 XeSS。</sys:String>
  <sys:String x:Key="Str.OptiStep2">按 Insert，打开 Neural 标签页并开启 Enable NR。</sys:String>
  <sys:String x:Key="Str.OptiStep3">若开启了光线重建（Ray Reconstruction），把处理点设为 "After the finished frame"。</sys:String>
  <sys:String x:Key="Str.InstallOpti">安装 OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">更新</sys:String>
  <sys:String x:Key="Str.Reinstall">重新安装</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">切换到 OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">切换到 ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">切换到 {0}？</sys:String>
  <sys:String x:Key="Str.SwitchBody">{0} 已安装 {1} 路线，两者不能同时存在于一个文件夹。会先移除 {1} 并还原它替换过的文件，然后安装 {2}。</sys:String>
  <sys:String x:Key="Str.SwitchYes">移除 {0}，安装 {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">你自己的设置文件保持原样。</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">不做任何更改；{0} 保持安装。</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">原因见“详情”。没有安装任何东西。</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">也可以用浏览器下载文件后导入：本机 &gt; 文件 &gt; 手动下载，然后点“导入文件”。“下载”文件夹中的文件会被自动找到。</sys:String>
  <sys:String x:Key="Str.DnsRetry">清除 DNS 并重试</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows 不允许从这里清除 DNS 缓存。请打开命令提示符，运行 ipconfig /flushdns，然后重试。</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">此文件夹中发现 {0} 个问题</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">可以安装，有 {0} 条提示需要查看</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">已安装到 {0}，下方有 {1} 条警告需要查看。</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">已从 {0} 移除，下方有 {1} 条警告需要查看。</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">下方列出了 {0} 个问题。</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">无下载列表</sys:String>
  <sys:String x:Key="Str.FailedShort">失败</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">全部 {0} 个就绪</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">缺 {0} 个 · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">无法下载：{0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">手动下载</sys:String>
  <sys:String x:Key="Str.ImportFiles">导入文件…</sys:String>
  <sys:String x:Key="Str.ImportHint">选择一个存放你自行下载文件的文件夹。每个文件按名称查找，且仅在与固定哈希一致时才会采用。</sys:String>
  <sys:String x:Key="Str.ManualTitle">自行下载文件</sys:String>
  <sys:String x:Key="Str.ManualBody">在浏览器中打开每个链接，把文件存到任意位置：“下载”文件夹会被自动搜索，其他文件夹可通过“导入文件”导入。无需改名，与固定 SHA-256 不符的文件一律不会使用。</sys:String>
  <sys:String x:Key="Str.ImportPick">选择存放已下载文件的文件夹</sys:String>
  <sys:String x:Key="Str.ImportAll">所有文件均已就位并通过校验。</sys:String>
  <sys:String x:Key="Str.ImportNothing">该文件夹中没有匹配所需文件的内容。</sys:String>
  <sys:String x:Key="Str.ImportSome">已采用：{0}。仍缺少：{1}。</sys:String>
  <sys:String x:Key="Str.Component.addon">Add-on</sys:String>
  <sys:String x:Key="Str.Component.runtime">神经网络运行时和模型权重</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32 位桥接</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32 位附加组件</sys:String>
  <sys:String x:Key="Str.Component.shader">配套效果</sys:String>
